# The canonical origin of the deployed site.
#
# Used for metadataBase, the Open Graph / Twitter card URLs, and sitemap.xml.
# Social cards require HTTPS — X refuses http:// images and several platforms
# fall back to a bare-URL preview — so always set an https:// origin.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console verification token (the "HTML tag" method). Optional:
# the verification tag is omitted until this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Impact site verification token. Optional: the verification tag is omitted until
# this is set. Impact's tag carries the token in `value=`, so it is rendered as a
# real meta tag rather than through the metadata API.
NEXT_PUBLIC_IMPACT_SITE_VERIFICATION=
